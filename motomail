configure_opendkim() {
# useful to try sending to legit mail providers
    mkdir -p "/etc/postfix/dkim/$fulldomain"
    opendkim-genkey -D "/etc/postfix/dkim/$fulldomain" -d "$fulldomain" -s "$subdom"
    chgrp -R opendkim /etc/postfix/dkim/*
    chmod -R g+r /etc/postfix/dkim/*
    grep -q "$fulldomain" /etc/postfix/dkim/keytable 2>/dev/null || \
	echo "$subdom._domainkey.$fulldomain $fulldomain:$subdom:/etc/postfix/dkim/$fulldomain/$subdom.private" >> /etc/postfix/dkim/keytable
    grep -q "$fulldomain" /etc/postfix/dkim/signingtable 2>/dev/null || \
	echo "*@$fulldomain $subdom._domainkey.$fulldomain" >> /etc/postfix/dkim/signingtable
    grep -q '127.0.0.1' /etc/postfix/dkim/trustedhosts 2>/dev/null || \
    cat >> /etc/postfix/dkim/trustedhosts << EOF
127.0.0.1
10.1.0.0/16
EOF
    grep -q '^KeyTable' /etc/opendkim.conf 2>/dev/null || \
cat >> /etc/opendkim.conf << EOF
KeyTable file:/etc/postfix/dkim/keytable
SigningTable refile:/etc/postfix/dkim/signingtable
InternalHosts refile:/etc/postfix/dkim/trustedhosts
EOF
    sed -i '/^#Canonicalization/s/simple/relaxed\/simple/' /etc/opendkim.conf
    sed -i '/^#Canonicalization/s/^#//' /etc/opendkim.conf
    sed -i '/Socket/s/^#*/#/' /etc/opendkim.conf
    grep -q '^Socket\s*inet:12301@localhost' /etc/opendkim.conf || echo 'Socket inet:12301@localhost' >> /etc/opendkim.conf
    sed -i '/^SOCKET/d' /etc/default/opendkim && echo "SOCKET=\"inet:12301@localhost\"" >> /etc/default/opendkim
}

