synergize_postfix_and_opendkim() {
    postconf -e 'smtpd_sasl_security_options = noanonymous, noplaintext'
    postconf -e 'smtpd_sasl_tls_security_options = noanonymous'
    #postconf -e "myhostname = $maildomain"
    postconf -e 'milter_default_action = accept'
    postconf -e 'milter_protocol = 6'
    postconf -e 'smtpd_milters = inet:localhost:12301'
    postconf -e 'non_smtpd_milters = inet:localhost:12301'
    postconf -e 'mailbox_command = /usr/lib/dovecot/deliver'
    postconf -e 'smtpd_forbid_bare_newline = normalize'
    postconf -e 'smtpd_forbid_bare_newline_exclusions = $mynetworks'
}

prevent_opendkim_pid_error() {
    # A fix for "Opendkim won't start: can't open PID file?", as specified here: https://serverfault.com/a/847442
    /lib/opendkim/opendkim.service.generate
    systemctl daemon-reload
}

configure_fail2ban() {
    [ ! -f /etc/fail2ban/jail.d/motomail.local ] && \
cat > /etc/fail2ban/jail.d/motomail.local << EOF
[postfix]
enabled = true
[postfix-sasl]
enabled = true
[sieve]
enabled = true
[dovecot]
enabled = true
EOF
    sed -i "s|^backend = auto$|backend = systemd|" /etc/fail2ban/jail.conf
}

enable_spamd() {
    sed -i "s|^CRON=0|CRON=1|" /etc/default/spamd
    service spamd restart
    systemctl enable spamd
}

restart_services() {
    for s in opendkim dovecot postfix fail2ban; do
        service "$s" restart
        systemctl enable "$s"
    done
}

set_certbot_hook() {
    # We can "specify hooks by placing files in subdirectories of Certbot’s configuration directory".
    # Any executable placed in "/etc/letsencrypt/renewal-hooks/deploy" will be executed after deploy.
    # Executables are run in alphabetical order.
    # Check official doc: https://eff-certbot.readthedocs.io/en/stable/using.html

cat > /etc/letsencrypt/renewal-hooks/deploy/motomail-restart-services.sh << EOF
#!/usr/bin/env bash
# Restart services if a mail certificate was (re)deployed less than 30 minutes ago.
for m in $fullmaildomain ; do # append domains here
    if (( \$(find -L "${certissuer_path}/\${m}" -type f -mmin -30 | wc -l) )); then
	for s in opendkim dovecot postfix fail2ban; do
	    service "\$s" restart
	done
	break;
    fi
done
exit 0
EOF

    chmod +x /etc/letsencrypt/renewal-hooks/deploy/motomail-restart-services.sh
}

update_certbot_hook() {
    local certbot_deploy_script=/etc/letsencrypt/renewal-hooks/deploy/motomail-restart-services.sh
    sed -i "s/; do # append domains here/$fulldomain ; do # append domains here/" $certbot_deploy_script
    chmod +x /etc/letsencrypt/renewal-hooks/deploy/motomail-restart-services.sh
}

add_postmaster_user() {
    # Add user postmaster with group mail
    useradd -m -G mail postmaster
}

configure_mta_sts() {
    # Add .well-known/mta-sts.txt to domain
    # TODO nginx only atm!
    local listen_ipv4=${ipv4:+"listen 443 ssl;"}
    local listen_ipv6=${ipv6:+"listen [::]:443 ssl;"}
cat > /etc/nginx/sites-available/mta-sts.${fulldomain}.conf << EOF
server {
    server_name mta-sts.$fulldomain;
    $listen_ipv6
    $listen_ipv4
    location = /.well-known/mta-sts.txt {
        default_type text/plain;
        return 200 "version: STSv1\nmode: enforce\nmax_age: 604800\nmx: $fullmaildomain";
    }
}
EOF
    ln -s /etc/nginx/sites-available/mta-sts.${fulldomain}.conf /etc/nginx/sites-enabled/mta-sts.${fulldomain}.conf

    id_mta_sts=$(date '+%s')
    info "Add those TXT records to your registrar:
    mta_sts=\"_mta-sts.$fulldomain	TXT	v=STSv1; id=$id_mta_sts\"
    smtp_tls=\"_smtp._tls.$fulldomain	TXT	v=TLSRPTv1\"
    "
    read -p "Press enter to continue..."
    certbot -d mta-sts.${fulldomain}
}

