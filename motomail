#!/usr/bin/env bash

main() {
    ensure_root
    parse_args "$@"
    get_mail_server_infos
    need_vps_configured
    if [[ $ADD_DOMAIN == true ]]; then
	:
    else
	install_deps
    	set_firewall
    fi
    generate_certificates
    if [[ $ADD_DOMAIN == true ]]; then
	update_postfix
	update_dovecot
	update_opendkim
    else
	configure_postfix
	configure_dovecot
	configure_opendkim
	synergize_postfix_and_opendkim
    fi
    prevent_opendkim_pid_error
    if [[ $ADD_DOMAIN == true ]]; then
	:
    else
	configure_fail2ban
	enable_spamd
    fi
    restart_services
    if [[ $ADD_DOMAIN == true ]]; then
	update_certbot_hook
    else
	set_certbot_hook
	add_postmaster_user
    fi
    configure_mta_sts
    configure_dane
    create_registrar_entries
    save_registrar_entries
    print_registrar_entries
}

info() { echo "[INFO] $*"; }
warn() { echo "[WARNING] $*"; }
error() { echo "[ERROR] $*"; exit 1; }
abort() { echo "Aborting."; exit 0; }

parse_args() {
    local args=($@)
    for arg in "${args[@]}"; do
	case $arg in
	    -a|--add-domain)
		info "Adding a new domain."
		ADD_DOMAIN=true
		;;
	esac
    done
}

ensure_root() {
    if [[ $EUID != 0 ]]; then
        error "This script must be run with root privileges."
    fi
}

check_domain() {
    read -p "Full mail domain (e.g. mail.example.org): " domain
    # remove https?:// from input
    domain="${domain//https:\/\//}"
    domain="${domain//http:\/\//}"
    local a="[a-zA-Z0-9]" b="[-a-zA-Z0-9]" c="[a-zA-Z]"
    local rough_regex="($a$b{1,61}$a)\.($a$b{1,61}$a)\.($c{2,}(\.$c{2,})?)"
    if [[ $domain =~ $rough_regex ]]; then
	subdom="${BASH_REMATCH[1]}"
	domain="${BASH_REMATCH[2]}"
	ltd="${BASH_REMATCH[3]}" # useless?
    else
	error "Incorrect domain."
    fi
}

confirm_infos() {
    maildomain=${subdom}.${domain}   	# mail.example
    fulldomain=${domain}.${ltd}      	# example.ltd
    fullmaildomain=${maildomain}.${ltd}	# mail.example.ltd
    ## debug
    #info "This is what you provided:
    #- subdom      : $subdom
    #- domain      : $domain
    #- maildomain  : $maildomain
    #- fulldomain  : $fulldomain
    #- fullmaildom : $fullmaildomain
    #- ltd         : $ltd
    #"
    info "Is this correct:
    - domain name    : $fulldomain
    - mail subdomain : $fullmaildomain
    "
    local answer
    read -p "Confirm? [Y|n] " answer # default to Yes
    [[ $answer =~ ([yY]|^$) ]] || get_mail_server_infos
}

get_mail_server_infos() {
    check_domain
    confirm_infos
}

grab_ips() {
    ipv4=$(host "$fulldomain" | grep -m1 -Po '([0-9]+\.){3}[0-9]+')
    ipv6=$(host "$fulldomain" | grep "IPv6" | awk '{print $NF}')
    if [[ -z $ipv4 && -z $ipv6 ]]; then
	error "No IP linked to $fulldomain"
    fi
}

need_vps_configured() {
    # Set up mail hoster with nginx before launching
    # Ensure port 25 is open on VPS provider
    info "Ensure your registrar's A and/or AAAA records point correctly to:
        \"$fullmaildomain\"
        \"mta-sts.$fulldomain\"
    "
    echo "This must be done before installing the mailserver."
    read -p "Press enter to continue..."

    grab_ips

    # Ensure nginx
    if ! command -v nginx >/dev/null 2>&1; then
        info "nginx is not installed on this machine
	motomail is NGINX COMPATIBLE-ONLY  at the moment"
	info "nginx will be installed"
	read -p "Press enter to continue..."
	apt install nginx -y
    fi
    #ensure certbot
    if ! command -v certbot >/dev/null 2>&1; then
	info "motomail is CERTBOT COMPATIBLE-ONLY  at the moment"
	info "certbot will be installed"
	read -p "Press enter to continue..."
	apt install python3-certbot python3-certbot-nginx certbot -y
    fi
}

install_deps() {
    deps=( postfix postfix-pcre dovecot-imapd dovecot-pop3d dovecot-sieve opendkim opendkim-tools spamassassin spamc net-tools fail2ban bind9-host )
    info "The following packages will be (re)installed: ${deps[@]}"
    read -p "Press enter to continue..."
    apt purge '~c' ${deps[@]} -y || error "Some dependencies failed to be purged."
    apt install ${deps[@]} -y || error "Some dependencies could not be installed."
}

set_firewall() {
    local firewalls=( ufw ) # Must be executable name, not package
    local ports=( 25 80 465 587 993 )
    for fw in "${firewalls[@]}"; do
	which "$fw" &>/dev/null || continue
	local found_firewall=true
	info "Opening some firewall ports"
	case $fw in
	    ufw)
		for port in "${ports[@]}"; do
		    ufw allow $port
		done
		;;
	    *)
		warn "$ufw is not yet configurable. Ignoring."
		;;
	esac
	break
    done
    [[ -z $found_firewall ]] && info "No firewall was found."
    info "Those ports need to be open: ${ports[@]}"
    info "If your mail server is behind a proxy, or if your VPS provider blocks ports by default, open them up."
    read -p "Press enter to continue..."
}

generate_certificates() {
    info "Generating certificate for \"$fullmaildomain\""
    certissuer_path=/etc/letsencrypt/live
    certdir=$certissuer_path/$fullmaildomain
    certbot -d "$fullmaildomain" --register-unsafely-without-email --agree-tos
}

configure_postfix() {
    # setting "/etc/postfix/main.cf"
    postconf -e "myhostname = $fullmaildomain"
    postconf -e "mail_name = $fulldomain"
    postconf -e "mydomain = $fulldomain"
    postconf -e 'mydestination = $myhostname, $mydomain, mail, localhost.localdomain, localhost, localhost.$mydomain'

    # comment it but could remove it
    sed -r "s/^(smtpd_tls_cert_file *=.*)/#\1/" /etc/postfix/main.cf
    sed -r "s/^(smtpd_tls_key_file *=.*)/#\1/" /etc/postfix/main.cf

    # postconf accepts no multi-lines input
    postconf -X "smtpd_tls_chain_files"
cat >> /etc/postfix/main.cf << EOF
smtpd_tls_chain_files =
    /etc/letsencrypt/live/$fullmaildomain/privkey.pem
    /etc/letsencrypt/live/$fullmaildomain/fullchain.pem
EOF

    postconf -e 'smtpd_tls_security_level = may'
    postconf -e 'smtp_tls_security_level = dane'
    echo "# Fallback in case Dane loose correct configured" >> /etc/postfix/main.cf
    echo "smtpd_tls_security_level = may" >> /etc/postfix/main.cf

    postconf -e 'smtpd_tls_auth_only = yes'
    postconf -e 'smtpd_tls_mandatory_protocols = >=TLSv1.3'
    postconf -e 'smtp_tls_mandatory_protocols = >=TLSv1.3'
    postconf -e 'smtpd_tls_protocols = >=TLSv1.3'
    postconf -e 'smtp_tls_protocols = >=TLSv1.3'

    postconf -e 'smtpd_sasl_auth_enable = yes'
    postconf -e 'smtpd_sasl_type = dovecot'
    postconf -e 'smtpd_sasl_path = private/auth'
    postconf -e "smtpd_sender_login_maps = pcre:/etc/postfix/login_maps.pcre"
    postconf -e 'smtpd_sender_restrictions = reject_sender_login_mismatch, permit_sasl_authenticated, permit_mynetworks, reject_unknown_reverse_client_hostname, reject_unknown_sender_domain'
    postconf -e 'smtpd_recipient_restrictions = permit_sasl_authenticated, permit_mynetworks, reject_unauth_destination, reject_unknown_recipient_domain'
    postconf -e 'smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination'
    postconf -e 'smtpd_helo_required = yes'
    postconf -e 'smtpd_helo_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname, reject_unknown_helo_hostname'
    postconf -e 'home_mailbox = mail/Inbox/'
    postconf -e "header_checks = regexp:/etc/postfix/header_checks"

    # Avoid headers-leak when client send mails
cat > /etc/postfix/header_checks << EOF
/^Received:.*/     IGNORE
/^X-Originating-IP:/    IGNORE
/^User-Agent:/	IGNORE
/^X-Mailer:/	IGNORE
EOF

    # Ensure sender's name corresponds to their username on the server.
    # Example: johndoe@example.org must correspond to user "johndoe"
    echo "/^(.*)@${fulldomain//\./\\\.}\$/   \${1}" > /etc/postfix/login_maps.pcre

    # Setting "/etc/postfix/master.cf"
    sed -i '/^\s*-o/d;/^\s*submission/d;/^\s*smtp/d' /etc/postfix/master.cf

cat >> /etc/postfix/master.cf << EOF
smtp unix - - n - - smtp
smtp inet n - y - - smtpd
  -o content_filter=spamassassin
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_tls_auth_only=yes
#  -o smtpd_enforce_tls=yes # will be removed soon
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_sender_login_maps=pcre:/etc/postfix/login_maps.pcre
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject_unauth_destination
smtps     inet  n       -       y       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
spamassassin unix -     n       n       -       -       pipe
  user=debian-spamd argv=/usr/bin/spamc -f -e /usr/sbin/sendmail -oi -f \${sender} \${recipient}

# For Dane support
dane       unix  -       -       n       -       -       smtp
  -o smtp_dns_support_level=dnssec
  -o smtp_tls_security_level=dane
EOF
}

update_postfix() {
    # setting "/etc/postfix/main.cf"
    # add to $mydestination
    local mydestination=$(grep "^mydestination = " /etc/postfix/main.cf)
    sed -i "s/$mydestination/${mydestination}, $fulldomain/" /etc/postfix/main.cf

    # Ensure sender's name corresponds to their username on the server.
    # Example: johndoe@example.org must correspond to user "johndoe"
    echo "/^(.*)@${fulldomain//\./\\\.}\$/   \${1}" >> /etc/postfix/login_maps.pcre
}

