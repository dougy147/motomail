    #|  cat cert.pem isrgrootx1.pem > motomail-fullchain.pem

    #|  See:
    #|  https://letsencrypt.org/certificates/
    #|  https://community.letsencrypt.org/t/difference-between-fullchain-pem-and-cert-pem/184189
    #|  https://github.com/certbot/certbot/issues/10189
    #|  https://community.letsencrypt.org/t/with-preferred-chain-isrg-root-x1-fullchain-pem-doesnt-contain-the-isrg-root-x1-certificate/163224
    #+------------------------------------------------------------------------------------------------
}

create_registrar_entries() {
    pval="$(tr -d '\n' <"/etc/postfix/dkim/$fulldomain/$subdom.txt" | sed "s/k=rsa.* \"p=/k=rsa; p=/;s/\"\s*\"//;s/\"\s*).*//" | grep -o 'p=.*')"
    dkimentry="$subdom._domainkey.$fulldomain	TXT	v=DKIM1; h=sha256; k=rsa; $pval"
    dmarcentry="_dmarc.$fulldomain	TXT	v=DMARC1; p=reject; rua=mailto:postmaster@$fulldomain; fo=1"
    spf_ipv4=${ipv4:+"ip4:$ipv4"}
    spf_ipv6=${ipv6:+"ip6:$ipv6"}
    spfentry="$fulldomain	TXT	v=spf1 mx a:$fullmaildomain $spf_ipv4 $spf_ipv6 -all"
    mxentry="$fulldomain	MX	10	$fullmaildomain	300"
    # mta-sts
    mta_sts="_mta-sts.$fulldomain	TXT	v=STSv1; id=$id_mta_sts"
    smtp_tls="_smtp._tls.$fulldomain	TXT	v=TLSRPTv1"
    # dane
    dane_current="_25._tcp.$fullmaildomain	TLSA	3 1 1 $dane_hash_current"
    dane_rollover="_25._tcp.$fullmaildomain	TLSA	2 1 1 $dane_hash_rollover"
}

save_registrar_entries() {
    cat > "$HOME/motomail_${fullmaildomain}.txt" << EOF
$dkimentry
$dmarcentry
$spfentry
$mxentry
$mta_sts
$smtp_tls
# Some registrar's don't have TLSA records section.
# If that is the case for you, try adding the below
# entries in TXT records instead.
$dane_current
$dane_rollover
EOF
}

print_registrar_entries() {
    # Inform user
    echo "Add/check those entries to your registrar:"
    echo -e "$dkimentry\n"
    echo -e "$dmarcentry\n"
    echo -e "$spfentry\n"
    echo -e "$mxentry\n"
    echo -e "$dane_current\n"
    echo -e "$dane_rollover\n"
    #echo -e "$mta_sts\n" # already done
    #echo -e "$smtp_tls\n" # already done
}

about_tlsa_renewal() {
    # TODO speech about TLSA renewal
    info "TLSA updating is not an easy-to-automatize task.\n \
	One solution is to add '--reuse-key' to certbot so it will not generate new SSL private keys. \n
	This is mostly safe if you never give your private key to anyone."
    :
}

main "$@"

